rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deploy with: firebase deploy --only firestore:rules
    //
    // Privileged writes go through server API routes (Admin SDK bypasses rules).
    // Client reads below support self-service profile access and public content.

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveMember() {
      return isSignedIn()
        && userDoc().data.active == true
        && userDoc().data.role in ['member', 'admin'];
    }

    function isAdmin() {
      return isSignedIn()
        && userDoc().data.active == true
        && userDoc().data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if resource.data.status == 'published'
        || (isActiveMember() && resource.data.status in ['draft', 'published', 'archived']);
      allow write: if isAdmin();
    }

    match /fleet/{id} {
      allow read: if resource.data.active == true && resource.data.status == 'active'
        || isAdmin();
      allow write: if isAdmin();
    }

    match /leadership/{id} {
      allow read: if resource.data.active == true && resource.data.status == 'active'
        || isAdmin();
      allow write: if isAdmin();
    }

    match /checklistTemplates/{id} {
      allow read: if isActiveMember() && resource.data.active == true;
      allow read, write: if isAdmin();
    }

    match /checklistSubmissions/{id} {
      allow read: if isAdmin()
        || (isActiveMember() && resource.data.submittedBy == request.auth.uid);
      allow create, update: if isActiveMember()
        && request.resource.data.submittedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /files/{id} {
      allow read: if isActiveMember();
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
